config_version=5

[application]
config/name="百谷长青"
config/description="在六种生态中探索种源、经营拓殖地，从采集走向现代农业。"
config/version="1.1.0"
config/features=PackedStringArray("4.7")
config/icon="res://art/riverbend.png"
boot_splash/image="res://art/riverbend.png"
boot_splash/bg_color=Color(0.08,0.12,0.10,1)
boot_splash/stretch_mode=0
config/use_custom_user_dir=true
config/custom_user_dir_name="RiceByTheRiver"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.59,0.65,0.61,1)
